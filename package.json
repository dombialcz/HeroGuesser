{
  "name": "guild-of-wits",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "python3 scripts/serve.py",
    "build": "node scripts/build-site.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "test:browser": "node scripts/check-browser-suite.mjs",
    "baseline": "node scripts/record-baseline.mjs",
    "ios:test": "node scripts/ios-workflow.mjs test",
    "check:release": "node scripts/check-release-ready.mjs",
    "ios": "node scripts/ios-workflow.mjs open",
    "ios:run": "node scripts/ios-workflow.mjs run"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3"
  }
}
